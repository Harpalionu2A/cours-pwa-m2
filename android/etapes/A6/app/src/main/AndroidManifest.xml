<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permission « normale » : déclarée, accordée à l'installation, sans dialogue. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- TD A6 : permission « dangereuse » (Android 13+) : déclarée ici, accordée à l'exécution par l'utilisateur. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CarnetApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Carnet">

        <!-- L'écran d'accueil : lancé par l'OS sur l'intent MAIN / LAUNCHER.
             singleTop : si Carnet est déjà au premier plan, un nouvel intent arrive dans onNewIntent
             au lieu de créer une deuxième instance. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Carnet">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- TD A3 : recevoir un texte partagé depuis n'importe quelle app (sélecteur « Partager »). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- TD A3 : App Link — l'URL de sa PWA ouvre Carnet au lieu du navigateur.
                 autoVerify : à l'installation, l'OS télécharge https://${pwaHost}/.well-known/assetlinks.json
                 et vérifie que l'empreinte de la clé de signature y figure. ${pwaHost} = PWA_HOST de local.properties. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${pwaHost}" />
            </intent-filter>
        </activity>

        <!-- TD A6 : le service que Play Services réveille à l'arrivée d'un message FCM, app ouverte ou non.
             exported=false : seul l'OS le lance, par l'intent-filter. -->
        <service
            android:name=".notif.CarnetMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Messages FCM de type « notification », affichés par l'OS sans passer par le service :
             le canal et l'icône qu'il utilisera (sinon : canal par défaut, icône de l'app). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="hub" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
    </application>

</manifest>
